# === CF 版说明 ===
# 本 fork 运行在 Cloudflare Workers + Durable Object 上，不再读 .env。
# - 非密钥变量：写在 wrangler.toml 的 [vars]
# - 密钥：wrangler secret put <NAME>（生产）或 .dev.vars（wrangler dev 本地）
# 本文件仅为密钥清单参考；复制为 .dev.vars 供本地开发使用。

# ---- 安全与管理鉴权 ----
# 管理区密码（控制推送/AI/订阅屏蔽/数据源运维与条目标记）。
# 部署到公网强烈建议设置强密码！留空则全部开放（仅适合本地调试）。
ADMIN_TOKEN=

# ---- 采集控制 ----
# 可选：GitHub API Token，将限额从 60/h 提到 5000/h
GITHUB_TOKEN=
# 逗号分隔只跑指定源（也可放 wrangler.toml vars）
ENABLED_SOURCES=

# ---- Cloudflare 绕过（可选，外挂服务）----
# linux.do 等被 CF 护盾保护的站点需要自建 FlareSolverr（HTTP 服务，可跑在任意 VPS）
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000

# ---- Telegram 推送（可选；另需 PUSH_CHANNEL=telegram，在 vars 里）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- AI 语义审核（可选）----
# 支持任意 OpenAI 兼容接口（DeepSeek / OpenAI / OneAPI / NewAPI 等）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---- 登录态站点回传（知乎 / 小红书 / 小黑盒 · 可选）----
# 配合 scripts/pw-collect.mjs 使用；留空则 /api/ingest 拒绝外部写入
INGEST_TOKEN=

# ---- CF 版已删除的变量（不再需要，列出防止误配）----
# PORT / HOST / DATABASE_PATH —— 无本地进程与文件
# HTTP_PROXY / HTTPS_PROXY / TELEGRAM_PROXY —— Workers 无出口代理
# ENABLE_SCHEDULER / COLLECT_CRON / 运行态调度 —— Cron Trigger 固定每分钟，见 wrangler.toml
