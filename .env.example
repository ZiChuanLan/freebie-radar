# ---- Docker 镜像（仅 docker-compose 使用）----
# 默认官方镜像；想固定版本或回滚可改成 zichuanlan/freebie-radar:v1.1.0 或某个 git 短 SHA
RADAR_IMAGE=zichuanlan/freebie-radar:latest

# ---- 云端提示词（可选）----
# 指向 raw 的 Markdown；留空则用代码内置的 DEFAULT_PROMPT。
# 改这里指向的仓库即可调整审核口径，不用发版；拉取失败会保留上一版。
# 默认关闭：自部署时指向你自己的提示词仓库再取消注释（上游那份是站长的口径，不一定适合你）
# PROMPT_URL=https://raw.githubusercontent.com/<you>/<repo>/main/system.md
# PROMPT_EXTRA_URL=https://raw.githubusercontent.com/<you>/<repo>/main/extra.md
# 轮询间隔（分钟）；0 = 只在启动时同步一次
# PROMPT_SYNC_MINUTES=10
# ---- 基础服务 ----
PORT=8788
HOST=0.0.0.0
# 数据库路径（本地相对项目根，Docker 默认 /data/radar.db）
DATABASE_PATH=./data/radar.db
TZ=Asia/Shanghai

# ---- 安全与管理鉴权 ----
# 管理区密码（控制推送/AI/订阅屏蔽/数据源运维与条目标记）。
# 留空仅在非生产 selfhost 下开放；公开站及 production 下管理区锁定！
ADMIN_TOKEN=
# 管理 API 可选专用域名（Host，可带端口；逗号分隔），留空兼容单域名
ADMIN_HOSTS=
# 只在源站端口已封口且反代会覆盖 X-Forwarded-For 后开启
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
# Docker 对宿主机默认仅回环发布；远程直连需显式修改，不建议公网直连
BIND_ADDRESS=127.0.0.1
# 仅 selfhost 可按需允许内网 Webhook；公开站始终拒绝内网
WEBHOOK_ALLOW_PRIVATE=false

# ---- 网络与代理（按需填写） ----
# 采集在海外服务器跑时可留空；国内本机调试可填 HTTP 代理（如 http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=
FETCH_TIMEOUT_MS=20000
MIN_REQUEST_GAP_MS=2000
SOURCE_GAP_MS=3000

# ---- Cloudflare 绕过（可选） ----
# 若启用 docker compose --profile cf，填 http://flaresolverr:8191 ；留空则直连
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000

# ---- 采集控制 ----
# 逗号分隔只跑指定源，留空表示按 DB 启停配置跑全部启用源
ENABLED_SOURCES=
MAX_ITEMS_PER_RUN=50
# 可选：GitHub API Token，将限额从 60/h 提到 5000/h
GITHUB_TOKEN=

# ---- 定时调度 ----
ENABLE_SCHEDULER=true
COLLECT_CRON=0 */2 * * *
DAILY_CRON=30 8 * * *
DAILY_TOP_N=12
PUBLIC_BASE_URL=

# ---- Telegram 推送（可选） ----
# none = 仅网页查看；telegram = 开启 Telegram 即时/攒批/日报推送
PUSH_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PROXY=

# ---- AI 语义审核（可选 · 仅首次初始化默认值，后续直接在网页「AI 引擎」热配置） ----
# 支持 Chat Completions / Responses 兼容接口；基础地址通常带 /v1，不含具体接口路径
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 协议类型（可选）：留空沿用 /chat/completions；填写 response 改用 /responses
# AI_BASE_URL 只填服务商基础地址（通常以 /v1 结尾），不要追加上述接口路径
# 与其他 AI 参数一样：作为初始化默认值，保存过后优先使用网页「AI 引擎」中的配置
AI_PROTOCOL=
AI_MAX_ITEMS=60

# ---- 登录态站点回传（知乎 / 小红书 / 小黑盒 · 可选） ----
# 配合 scripts/pw-collect.mjs 使用；留空则 /api/ingest 拒绝外部写入
INGEST_TOKEN=

# ---- 站点形态与多用户（公开站才需要，单人自建可整段留空） ----
# auto = 配齐任一 OAuth 渠道凭据就按公开站跑，否则按单人自建
# selfhost = 强制单人自建（全局收藏/屏蔽，行为与旧版一致）
# public   = 公开站：公共内容只读共享，个人状态按登录用户隔离
SITE_MODE=auto

# LINUX DO Connect OAuth2（在 https://connect.linux.do 申请，回调填 <站点>/api/auth/linuxdo/callback）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 不填则按 PUBLIC_BASE_URL 或请求 Host 自动推导
LINUXDO_REDIRECT_URI=
# 登录所需最低信任等级（0-4），后台还能再热改
LINUXDO_MIN_TRUST_LEVEL=0
# 仅 OAuth 用的代理（国内网络直连 connect.linux.do 常被污染/阻断）；
# 留空则回退 HTTP_PROXY / HTTPS_PROXY。设了它不会影响采集走代理。
LINUXDO_PROXY=

# ---- GitHub 登录（可选，与 LINUX DO 并存） ----
# OAuth App 回调必须逐字符一致：线上 https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 留空则由 PUBLIC_BASE_URL + /api/auth/github/callback 推导
GITHUB_REDIRECT_URI=
# 仅 GitHub OAuth 用的代理；留空回退 LINUXDO_PROXY → HTTP(S)_PROXY
GITHUB_PROXY=

# Session 与个人 Bot Token 加密密钥（留空则首次启动自动生成并写入 settings 表）
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# 本地模拟登录（仅 NODE_ENV=development + 回环 Host + 显式 true 时生效）
AUTH_DEV_MOCK=false

# 个人推送护栏：单用户每小时 / 每轮即时上限
USER_PUSH_MAX_PER_HOUR=40
USER_PUSH_MAX_PER_INSTANT=5

# ---- 版本检测与一键更新（可选） ----
SELF_UPDATE_REMOTE=origin
SELF_UPDATE_BRANCH=main
# 更新完成后执行的命令；留空则进程自行退出，交给 systemd / pm2 / docker restart 拉起
SELF_UPDATE_RESTART_CMD=
# 容器部署时可指向宿主机更新脚本（POST 一次即触发重建镜像）
UPDATE_WEBHOOK_URL=
UPDATE_WEBHOOK_TOKEN=
# 容器构建时注入，便于在后台显示当前运行的提交
APP_COMMIT=
APP_BUILD_TIME=
APP_REPO=ZiChuanLan/freebie-radar
