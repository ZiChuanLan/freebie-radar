# ---- 服务 ----
PORT=8788
HOST=0.0.0.0
# 数据库文件路径（相对项目根，Docker 内为 /data/radar.db）
DATABASE_PATH=./data/radar.db

# ---- 出网 ----
# 采集在墙外服务器上跑时留空；本机开发可指向一个 HTTP 代理
HTTP_PROXY=
HTTPS_PROXY=
# 单次请求超时（毫秒）
FETCH_TIMEOUT_MS=20000
# 同一源两次请求之间的最小间隔（毫秒）
MIN_REQUEST_GAP_MS=2000

# ---- Cloudflare 绕过 ----
# FlareSolverr 地址，例如 http://10.144.144.6:8191 ；留空则 linux.do 直连（大概率 403）
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000

# ---- 采集开关 ----
# 逗号分隔，留空表示全部启用；可选值见 src/server/collectors/index.ts
ENABLED_SOURCES=
# 单源单次最多抓取条数
MAX_ITEMS_PER_RUN=50

# ---- GitHub ----
# 可选，填了把限额从 60/h 提到 5000/h
GITHUB_TOKEN=

# ---- 调度 ----
# 采集周期（cron 表达式，默认每 2 小时）
COLLECT_CRON=0 */2 * * *
# 每日日报生成时间
DAILY_CRON=30 8 * * *
ENABLE_SCHEDULER=true

# ---- 精选与推送 ----
DAILY_TOP_N=12
# 站点对外地址，用于日报里的链接（留空自动用请求 Host）
PUBLIC_BASE_URL=
# 推送开关：none | telegram；none 时只落本地日报文件
PUSH_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# 推送需要出网，可单独给一个代理（如墙外机器）
TELEGRAM_PROXY=

# ---- 可选 AI 二审 ----
# 兼容 OpenAI 的网关；留空则只走规则打分
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 每轮最多送审多少条
AI_MAX_ITEMS=20
