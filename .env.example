# ---- 基础服务 ----
PORT=8788
HOST=0.0.0.0
# 数据库路径（本地相对项目根，Docker 默认 /data/radar.db）
DATABASE_PATH=./data/radar.db
TZ=Asia/Shanghai

# ---- 安全与管理鉴权 ----
# 管理区密码（控制推送/AI/订阅屏蔽/数据源运维与条目标记）。
# 留空则全部开放（仅适合本机内网）；部署到公网强烈建议设置强密码！
ADMIN_TOKEN=

# ---- 网络与代理（按需填写） ----
# 采集在海外服务器跑时可留空；国内本机调试可填 HTTP 代理（如 http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=
FETCH_TIMEOUT_MS=20000
MIN_REQUEST_GAP_MS=2000
SOURCE_GAP_MS=3000

# ---- Cloudflare 绕过（可选） ----
# 若启用 docker compose --profile cf，填 http://flaresolverr:8191 ；留空则直连
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000

# ---- 采集控制 ----
# 逗号分隔只跑指定源，留空表示按 DB 启停配置跑全部启用源
ENABLED_SOURCES=
MAX_ITEMS_PER_RUN=50
# 可选：GitHub API Token，将限额从 60/h 提到 5000/h
GITHUB_TOKEN=

# ---- 定时调度 ----
ENABLE_SCHEDULER=true
COLLECT_CRON=0 */2 * * *
DAILY_CRON=30 8 * * *
DAILY_TOP_N=12
PUBLIC_BASE_URL=

# ---- Telegram 推送（可选） ----
# none = 仅网页查看；telegram = 开启 Telegram 即时/攒批/日报推送
PUSH_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PROXY=

# ---- AI 语义审核（可选 · 仅首次初始化默认值，后续直接在网页「AI 引擎」热配置） ----
# 支持任意 OpenAI 兼容接口（如 DeepSeek / OpenAI / OneAPI / NewAPI 等）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_ITEMS=60

# ---- 登录态站点回传（知乎 / 小红书 / 小黑盒 · 可选） ----
# 配合 scripts/pw-collect.mjs 使用；留空则 /api/ingest 拒绝外部写入
INGEST_TOKEN=
