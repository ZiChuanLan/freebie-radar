{
  "name": "freebie-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "migrate": "tsx src/server/migrate.ts",
    "collect": "tsx src/server/cli.ts collect",
    "daily": "tsx src/server/cli.ts daily",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.9.10",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
